{
  "name": "@brrr/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/ tests/",
    "fmt": "oxfmt --write src/ tests/",
    "fmt:check": "oxfmt --check src/ tests/"
  },
  "dependencies": {
    "@effect/platform": "^0.94.5",
    "@effect/platform-node": "^0.104.1",
    "@effect/sql": "^0.49.0",
    "@effect/sql-pg": "^0.50.3",
    "@octokit/app": "^15.1.1",
    "@octokit/rest": "^21.1.1",
    "effect": "^3.19.19",
    "jose": "^6.2.1"
  },
  "devDependencies": {
    "@effect/vitest": "^0.27.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
